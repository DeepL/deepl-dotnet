<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net462</TargetFrameworks>
    <!-- The .NET 8 SDK cannot target net10.0; it builds and runs the other targets. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '10.0'))">net8.0;net462</TargetFrameworks>
    <LangVersion>8</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../DeepL/sgKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JunitXml.TestLogger" Version="3.0.98" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="RichardSzalay.MockHttp" Version="7.1.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\DeepL\DeepL.csproj" Condition="'$(DeepLLibraryFramework)' == ''" />
  </ItemGroup>

  <!-- Run the tests against a specific library build, e.g. -p:DeepLLibraryFramework=netstandard2.0 to test the
       netstandard2.0 build (used by .NET Framework) on a .NET 8+ runtime. -->
  <PropertyGroup Condition="'$(DeepLLibraryFramework)' == 'netstandard2.0'">
    <!-- Lets tests skip features that only the library's net8.0 build has, such as the connect timeout. -->
    <DefineConstants>$(DefineConstants);DEEPL_NETSTANDARD2_0</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DeepLLibraryFramework)' != ''">
    <ProjectReference Include="..\DeepL\DeepL.csproj" SetTargetFramework="TargetFramework=$(DeepLLibraryFramework)" />
  </ItemGroup>

  <!-- NuGet restore ignores SetTargetFramework, so the netstandard2.0-only dependencies of the library must be
       referenced here to reach the test output. -->
  <ItemGroup Condition="'$(DeepLLibraryFramework)' == 'netstandard2.0' And '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/**"> <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory> </Content>
  </ItemGroup>

</Project>
